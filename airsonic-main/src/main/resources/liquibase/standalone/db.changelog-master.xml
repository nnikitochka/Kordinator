<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="standalone-auth-tables-1" author="airsonic">
        <createTable tableName="local_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_local_user"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_local_user_username"/>
            </column>
            <column name="password_hash" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_session">
            <column name="token_hash" type="CHAR(64)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_session"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_session" baseColumnNames="user_id"
                                 constraintName="fk_user_session_user" referencedTableName="local_user"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="user_session" indexName="ix_user_session_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="user_session" indexName="ix_user_session_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
    <changeSet id="standalone-library-table-1" author="airsonic">
        <createTable tableName="music_library">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_music_library"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_music_library_name"/>
            </column>
            <column name="root_path" type="VARCHAR(4096)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="standalone-scan-and-track-tables-1" author="airsonic">
        <createTable tableName="library_scan_job">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_library_scan_job"/>
            </column>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="tracks_scanned" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_count" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="library_scan_job" baseColumnNames="library_id"
                                 constraintName="fk_library_scan_job_library" referencedTableName="music_library"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="library_scan_job" indexName="ix_library_scan_job_library">
            <column name="library_id"/>
            <column name="started_at"/>
        </createIndex>

        <createTable tableName="media_track">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_media_track"/>
            </column>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="relative_path" type="VARCHAR(4096)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="artist" type="VARCHAR(512)"/>
            <column name="album" type="VARCHAR(512)"/>
            <column name="album_artist" type="VARCHAR(512)"/>
            <column name="duration_seconds" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="scan_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="scanned_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="media_track" baseColumnNames="library_id"
                                 constraintName="fk_media_track_library" referencedTableName="music_library"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="media_track" indexName="ix_media_track_library">
            <column name="library_id"/>
        </createIndex>
        <createIndex tableName="media_track" indexName="ix_media_track_artist_album">
            <column name="artist"/>
            <column name="album"/>
        </createIndex>
    </changeSet>
    <changeSet id="standalone-playlist-tables-1" author="airsonic">
        <createTable tableName="user_playlist">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_playlist"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_playlist" baseColumnNames="owner_id"
                                 constraintName="fk_user_playlist_owner" referencedTableName="local_user"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="user_playlist" indexName="ix_user_playlist_owner">
            <column name="owner_id"/>
            <column name="updated_at"/>
        </createIndex>

        <createTable tableName="user_playlist_track">
            <column name="playlist_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_playlist_track"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_playlist_track"/>
            </column>
            <column name="track_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_playlist_track" baseColumnNames="playlist_id"
                                 constraintName="fk_user_playlist_track_playlist" referencedTableName="user_playlist"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="user_playlist_track" baseColumnNames="track_id"
                                 constraintName="fk_user_playlist_track_track" referencedTableName="media_track"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="user_playlist_track" indexName="ix_user_playlist_track_track">
            <column name="track_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="standalone-track-tags-1" author="kordinator">
        <addColumn tableName="media_track">
            <column name="disc_number" type="INT"/>
            <column name="track_number" type="INT"/>
            <column name="year" type="INT"/>
            <column name="genre" type="VARCHAR(512)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
