<?xml version="1.0" encoding="UTF-8" ?>

<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
        version="2.0">

    <description>Port of the retired jakarta-taglibs string library (only the tags Airsonic uses:
        truncateNicely and randomString). The original library is javax.servlet-based and
        incompatible with Tomcat 10.1, so the tags are re-implemented locally under the same URI
        to keep the JSPs unchanged.</description>
    <display-name>Airsonic string tag library</display-name>
    <tlib-version>1.1</tlib-version>
    <short-name>str</short-name>
    <uri>http://jakarta.apache.org/taglibs/string-1.1</uri>

    <tag>
        <description>Truncates a string nicely at a word boundary, appending an ellipsis.</description>
        <name>truncateNicely</name>
        <tag-class>org.airsonic.player.taglib.TruncateNicelyTag</tag-class>
        <body-content>JSP</body-content>
        <attribute>
            <description>Minimum number of characters to keep when searching for a word boundary.</description>
            <name>lower</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
        <attribute>
            <description>Maximum length of the resulting string.</description>
            <name>upper</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
        <attribute>
            <description>String to append to a truncated string.</description>
            <name>appendToEnd</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
        <attribute>
            <description>Name of the exported scoped variable for the result.</description>
            <name>var</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>

    <tag>
        <description>Generates a random lowercase string of the given length.</description>
        <name>randomString</name>
        <tag-class>org.airsonic.player.taglib.RandomStringTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <description>Number of characters to generate.</description>
            <name>count</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
        <attribute>
            <description>Character type (only "alphabet" is implemented; accepted for compatibility).</description>
            <name>type</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
        <attribute>
            <description>Name of the exported scoped variable for the result.</description>
            <name>var</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>
</taglib>
